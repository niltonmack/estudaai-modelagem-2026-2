# Copie para apps/api/.env (não commite senha real).
PORT=3001
JWT_SECRET=troque-este-segredo-em-desenvolvimento
JWT_EXPIRES_IN=8h
# Laboratório: MySQL80 em 127.0.0.1:3306 (não há listener em 3336). Schema estudaai, separado do dentalapp.
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=estudaai
DB_PASSWORD=estudaai
DB_NAME=estudaai
ADMIN_NOME=Mariana Costa
ADMIN_EMAIL=mariana@estudaai.local
ADMIN_SENHA=AdminTemp1
LOG_FILE=../../logs/estudaai.log
# Só na API Nest (nunca no Next.js). O interruptor liga/desliga na UI admin.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Só na API Nest. Índice já criado: estudaai-trilhas, 1024 dimensões, field map text.
PINECONE_API_KEY=
PINECONE_INDEX=estudaai-trilhas

# apps/web/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:3001
