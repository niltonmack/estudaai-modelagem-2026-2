# Valores interpolados pelo .mcp.json via ${NOME} (ambiente do processo).
# Preencha os placeholders. Nao coloque senha real no Git.
# O Claude Code NAO carrega este arquivo sozinho: exporte as variaveis
# (veja .claude/CLAUDE.md) ou copie os valores para o ambiente do sistema.

# --- GitHub ---
GITHUB_PERSONAL_ACCESS_TOKEN=sua-chave

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=sua-chave
AWS_SECRET_ACCESS_KEY=sua-chave
AWS_BUCKET=seu-bucket-padrao
AWS_READONLY=false

# --- Azure Blob ---
AZURE_STORAGE_CONNECTION_STRING=sua-connection-string
AZURE_STORAGE_CONTAINER=seu-container-padrao
AZURE_STORAGE_NAME=seu-usuario
AZURE_STORAGE_KEY=sua-chave
AZURE_STORAGE_URL=https://seu-host
AZURE_READONLY=false

# --- SQL Server ---
MSSQL_HOST=seu-host
MSSQL_PORT=1433
MSSQL_USER=seu-usuario
MSSQL_PASSWORD=sua-senha
MSSQL_DATABASE=seu-banco
MSSQL_READONLY=false

# --- SSH ---
SSH_HOST=seu-host
SSH_PORT=22
SSH_USERNAME=seu-usuario
SSH_PASSWORD=sua-senha

# --- PostgreSQL ---
PGHOST=seu-host
PGPORT=5432
PGUSER=seu-usuario
PGPASSWORD=sua-senha
PGDATABASE=seu-banco
PGSSLMODE=
PG_READONLY=false

# --- MySQL ---
MYSQL_HOST=seu-host
MYSQL_PORT=3306
MYSQL_USER=seu-usuario
MYSQL_PASSWORD=sua-senha
MYSQL_DATABASE=seu-banco
MYSQL_READONLY=false

# --- Redis ---
REDIS_HOST=seu-host
REDIS_PORT=6379
REDIS_PWD=sua-senha
REDIS_SSL=false
REDIS_DB=0
REDIS_READONLY=false

# --- FTP ---
FTP_HOST=seu-host
FTP_PORT=21
FTP_USER=seu-usuario
FTP_PASSWORD=sua-senha
FTP_PROTOCOL=ftp
FTP_IMPLICIT_TLS=false
FTP_READONLY=false
